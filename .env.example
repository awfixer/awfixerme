# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to 
DATABASE_URL=
DATABASE_URL_POOLER=

# Stripe (Better Auth plugin). Placeholders — replace with real test/live keys.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_STARTER=price_placeholder_starter
STRIPE_PRICE_PRO=price_placeholder_pro

# Resend (Better Auth emails). Placeholders — replace with a real API key
# and a verified domain sender.
RESEND_API_KEY=re_placeholder
RESEND_FROM=AWFixer Auth <auth@awfixer.me>

# Dub (Better Auth lead tracking). Placeholder — replace with a real token.
DUB_TOKEN=dub_placeholder

# DatoCMS Content Management API token (server-side).
DATO_CMS_API_TOKEN=placeholder_dato_cms_token
